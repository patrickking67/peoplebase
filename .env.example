# PeopleBase reads its settings from environment variables. It does not load
# .env by itself, so copy this file to .env and export it into your shell:
#   cp .env.example .env
#   set -a; source .env; set +a

# Required. Signs the session cookie that holds the sign-in, flash messages
# and CSRF tokens. Changing it signs everyone out.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Any SQLAlchemy URL. Defaults to SQLite at instance/employees.db.
# DATABASE_URL=postgresql+psycopg://peoplebase:password@localhost:5432/peoplebase

# Optional. Set to 1 wherever PeopleBase is served over HTTPS, so the session
# cookie is only ever sent over TLS. Leave it off for http://127.0.0.1.
# SESSION_COOKIE_SECURE=1

# Optional. Set to 1 to turn on the Flask debugger when running "python app.py".
# Never enable it on a public host.
FLASK_DEBUG=0
